{
  "default": {
    "stt": "turbo-en",
    "cleanup": "glossary"
  },
  "stt": {
    "fake": {
      "kind": "fake"
    },
    "turbo-en": {
      "kind": "whisper-cpp",
      "model": "~/models/whisper/ggml-large-v3-turbo.bin",
      "language": "en",
      "prompt": "oc, kubectl, ArgoCD, Trident, HAProxy, RHCOS, OpenShift, Terraform"
    },
    "turbo-en-noprompt": {
      "kind": "whisper-cpp",
      "model": "~/models/whisper/ggml-large-v3-turbo.bin",
      "language": "en"
    },
    "turbo-en-context": {
      "kind": "whisper-cpp",
      "model": "~/models/whisper/ggml-large-v3-turbo.bin",
      "language": "en",
      "prompt": "Technical dictation about Kubernetes, OpenShift, ArgoCD, Terraform, AWS, kubectl and oc commands."
    },
    "turbo-en-norm": {
      "kind": "whisper-cpp",
      "model": "~/models/whisper/ggml-large-v3-turbo.bin",
      "language": "en",
      "prompt": "oc, kubectl, ArgoCD, Trident, HAProxy, RHCOS, OpenShift, Terraform",
      "normalize": true
    },
    "large-en": {
      "kind": "whisper-cpp",
      "model": "~/models/whisper/ggml-large-v3.bin",
      "language": "en",
      "prompt": "oc, kubectl, ArgoCD, Trident, HAProxy, RHCOS, OpenShift, Terraform"
    }
  },
  "cleanup": {
    "fake": {
      "kind": "fake"
    },
    "glossary": {
      "kind": "glossary",
      "rules": "glossary/en.json",
      "voice_commands": true
    }
  }
}
